  },
  {
   "seq": "35",
   "text": "祝言をきくの色そふわかき見のちとせのほとをおもひこそやれ",
   "kana": "",
   "speaker": "一金弐百文",
   "page": 5,
   "pid": "nao-733158",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "つきもせすにほへる岸のきくの花天か千世こそ思ひやく流れ",
   "kana": "",
   "speaker": "兵衛督",
   "page": 6,
   "pid": "nao-733158",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "かきりなくにほへる岸の白菊にちとせのつるのおるかとそみる",
   "kana": "",
   "speaker": "右大弁",
   "page": 6,
   "pid": "nao-733158",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "岸にさく菊のにほひを久しともきみかよにこそしるへかりけれ",
   "kana": "",
   "speaker": "源宰相",
   "page": 6,
   "pid": "nao-733158",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "ゆくすゑもにほはんほとは菊の花しつくのなかれくみてこそしれ",
   "kana": "",
   "speaker": "頭中将",
   "page": 6,
   "pid": "nao-733158",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "流れゆく春ゑのよまてにつきもせすさしてにほへる菊の白露",
   "kana": "",
   "speaker": "弁義忠",
